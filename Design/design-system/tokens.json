    "desktop": {
      "sidebarWidth": 240,
      "topBarHeight": 56,
      "contentMaxWidth": 1200,
      "contentMinWidth": 800,
      "windowMin": { "width": 800, "height": 600 },
      "windowDefault": { "width": 1280, "height": 800 }
    }
