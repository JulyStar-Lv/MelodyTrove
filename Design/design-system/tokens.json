      "play-fill", "pause-fill", "next-fill", "prev-fill",
      "shuffle-line", "repeat-line", "repeat-one-line",
      "home-line", "home-fill", "playlist-line", "playlist-fill",
      "ranking-line", "ranking-fill", "search-line", "search-fill",
      "mine-line", "mine-fill",
      "heart-line", "heart-fill", "download-line", "share-line",
      "more-line", "add-line", "queue-line",
      "back-line", "close-line", "theme-line", "settings-line",
      "scan-line", "folder-line"
