      "divider": "#1F1F28",
      "fill": { "icon": "#F5F5F7", "iconSub": "#6B6B75" }
    },
    "functional": {
      "success": "#22C55E",
      "warning": "#F59E0B",
      "danger": "#EF4444",
      "like": "#FB7185"
