{
  "meta": {
    "product": "TideTune",
    "version": "1.0.0",
    "updated": "2026-06-24"
  },
  "color": {
    "brand": {
      "primary": "#2E7CF6",
      "secondary": "#6C5CE7",
      "gradient": { "type": "linear", "angle": 135, "stops": ["#2E7CF6", "#6C5CE7"] },
      "gradientSoft": { "type": "linear", "angle": 135, "stops": ["#5B9BF5", "#8B7CEC"], "alpha": 0.5 }
    },
    "light": {
      "bg": { "base": "#FFFFFF", "elevated": "#F7F8FA", "overlay": "#00000040" },
      "text": { "primary": "#1A1A1F", "secondary": "#6B6B75", "tertiary": "#9A9AA3", "inverse": "#FFFFFF" },
      "divider": "#EFEFF2",
      "fill": { "icon": "#1A1A1F", "iconSub": "#9A9AA3" }
    },
    "dark": {
      "bg": { "base": "#0B0B0F", "elevated": "#16161D", "overlay": "#00000099" },
