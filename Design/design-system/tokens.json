  "shadow": {
    "light": {
      "0": "none",
      "1": "0 1px 2px rgba(0,0,0,0.04)",
      "2": "0 4px 12px rgba(0,0,0,0.06)",
      "3": "0 12px 32px rgba(46,124,246,0.20)"
    },
    "dark": {
      "0": "1px solid #1F1F28",
      "1": "1px solid #2A2A35",
      "2": "1px solid #2A2A35, inset 0 0 0 1px rgba(91,155,245,0.10)",
      "3": "inset 0 0 24px rgba(108,92,231,0.30)"
    }
  },
  "icon": {
    "grid": 24,
    "strokeWidth": 2,
    "lineCap": "round",
    "sizes": { "inline": 20, "nav": 24, "player": 28, "playButton": 32 },
